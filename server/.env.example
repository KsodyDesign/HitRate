PORT=3000

# Адрес сервера, который будет зашит в QR-коды (на VPS укажите http://<IP_VPS>:3000 или http://<IP_VPS>)
PUBLIC_BASE_URL=http://localhost:3000

# Подключение к PostgreSQL
DATABASE_URL=postgresql://hitrate:hitrate_dev_password@localhost:5432/hitrate

# Настройки внешнего ИИ-API (любой OpenAI-совместимый провайдер)
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://ai-proxy.fastapicloud.dev/v1
AI_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
